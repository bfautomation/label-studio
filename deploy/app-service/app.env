# Runtime settings that are neither secret nor environment-specific.
# The harness loads this file as is; App Service app settings copy it. Secrets and per-environment values are listed
# in README.md. Redis settings are deliberately absent: App Service runs it without Redis or a worker.

# PostgreSQL with the app's own login; the server address and password are set per environment
DJANGO_DB=default
POSTGRE_PORT=5432
POSTGRE_NAME=labelstudio
POSTGRE_USER=labelstudio
# libpq reads this directly: encrypt and verify the server's identity. The entrypoint's
# POSTGRE_SSL_MODE=verify-full is not used because it also demands a client certificate.
PGSSLMODE=verify-full

# App Service persists only /home
LABEL_STUDIO_BASE_DATA_DIR=/home/label-studio

# The front door terminates HTTPS and forwards plain HTTP with this header
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# Cookies only travel over HTTPS. Must be 1, not true: base.py parses these as integers
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# Accounts only by invitation
LABEL_STUDIO_DISABLE_SIGNUP_WITHOUT_LINK=true

# No usage or error reporting to HumanSignal
COLLECT_ANALYTICS=false
SENTRY_DSN=
FRONTEND_SENTRY_DSN=

# No nginx: Django serves uploaded files itself, with Range support and the sandbox CSP
USE_NGINX_FOR_UPLOADS=false
# App Service's front door drops requests after about 230 s; stop the worker just before that
UWSGI_WORKER_HARAKIRI=220
UWSGI_HTTP_TIMEOUT=230

# Structured logs for Log Analytics; the default level is DEBUG
JSON_LOG=1
LOG_LEVEL=INFO
